# SatQuery AI Environment Configuration

# Optional: Claude API key for Agentic Tool-Use Router (falls back to autonomous heuristic router if empty)
ANTHROPIC_API_KEY=

# MongoDB URI (local or Atlas)
MONGODB_URI=mongodb://localhost:27017/satquery

# Kaggle Credentials (for downloading fine-tuned weights)
KAGGLE_USERNAME=
KAGGLE_KEY=

# Model Path
MODEL_CHECKPOINT_PATH=./models/satquery_unified.pt

# FastAPI Host & Port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Next.js API URL
NEXT_PUBLIC_API_URL=http://localhost:8000
